# Enter these in Vercel -> Project -> Settings -> Environment Variables, then redeploy.
# Never put real values in GitHub.

# --- Supabase Auth (@supabase/ssr) + Relational Favourites/Profile ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-side-secret-key
APP_URL=http://localhost:3000
ADMIN_API_KEY=make-up-a-long-random-password

# --- needed for the Gemini analysis (Phase 2) ---
GEMINI_API_KEY=your-key-from-google-ai-studio
# Pick a model name from Google AI Studio's model list. There is deliberately no default.
GEMINI_MODEL=
# Protects the daily job. Make up another random string, 16+ characters.
CRON_SECRET=make-up-another-long-random-string

# --- optional ---
# Max reviews analyzed per run (default 200, max 1000). Protects your Gemini quota.
DAILY_ANALYSIS_LIMIT=200
# Leave false unless live checks of amazon.in pages are permitted for you.
ENABLE_DIRECT_PAGE_CHECK=false
# Secret used to HMAC-sign ReviewLens user session tokens (32+ random characters recommended).
AUTH_SESSION_SECRET=make-up-a-32-character-random-session-secret
